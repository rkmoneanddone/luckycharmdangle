<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================= -->
    <!-- PREMIUM SHADOW                            -->
    <!-- ========================================= -->

    <DropShadowEffect x:Key="PanelShadow"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Opacity="0.18"/>


    <!-- ========================================= -->
    <!-- NORMAL BUTTON                             -->
    <!-- ========================================= -->

    <Style x:Key="GlassButton"
           TargetType="Button">

        <Setter Property="Background"
                Value="#FFFFFF"/>

        <Setter Property="Foreground"
                Value="#182230"/>

        <Setter Property="BorderBrush"
                Value="#E4E9F0"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Padding"
                Value="14,9"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Cursor"
                Value="Hand"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>


        <!-- Hover -->

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="#F4F7FB"/>

            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- ========================================= -->
    <!-- BLUE PRIMARY BUTTON                       -->
    <!-- ========================================= -->

    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource GlassButton}">

        <Setter Property="Background"
                Value="#1769E0"/>

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="BorderBrush"
                Value="#1769E0"/>


        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="Background"
                        Value="#0E5AC8"/>

            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- ========================================= -->
    <!-- CHARM TILE                                -->
    <!-- ========================================= -->

    <Style x:Key="CharmTile"
           TargetType="Button">

        <Setter Property="Background"
                Value="#FFFFFF"/>

        <Setter Property="Foreground"
                Value="#182230"/>

        <Setter Property="BorderBrush"
                Value="#E3E8EF"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="Margin"
                Value="5"/>

        <Setter Property="Cursor"
                Value="Hand"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="8">

                        <ContentPresenter/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>


        <!-- Hover -->

        <Style.Triggers>

            <Trigger Property="IsMouseOver"
                     Value="True">

                <Setter Property="BorderBrush"
                        Value="#1769E0"/>

                <Setter Property="Background"
                        Value="#F8FBFF"/>

            </Trigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>