<Window x:Class="LuckyDangle.UI.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LuckyCharm"
        Width="410"
        Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF9F0"
        ShowInTaskbar="False"
        MouseLeftButtonDown="AboutWindow_MouseLeftButtonDown">

    <Border Padding="24,18">

        <StackPanel>

            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <Image x:Name="AboutLogo"
                Width="88"
                Height="88"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Margin="0,0,0,2"/>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextBlock Text="LuckyCharm"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#4A3218"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Version 0.1.0"
                       FontSize="13"
                       Foreground="#806B55"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,12"/>


            <!-- ================================================= -->
            <!-- DESCRIPTION -->
            <!-- ================================================= -->

            <TextBlock Text="A tiny transparent desktop companion that brings interactive lucky charms to your Windows desktop."
                       FontSize="14"
                       Foreground="#4A4036"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       MaxWidth="330"
                       Margin="0,0,0,12"/>


            <!-- ================================================= -->
            <!-- DEVELOPER -->
            <!-- ================================================= -->

            <TextBlock Text="Developed by"
                       FontSize="12"
                       Foreground="#806B55"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Rohit Kumar Mallick"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#4A3218"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,9"/>


            <!-- ================================================= -->
            <!-- CONTACT -->
            <!-- ================================================= -->

            <TextBlock Text="Contact"
                       FontSize="12"
                       Foreground="#806B55"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="wishugreens@gmail.com"
                       FontSize="14"
                       Foreground="#8A5A18"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,10"/>


            <!-- ================================================= -->
            <!-- BUY ROHIT A COFFEE -->
            <!-- ================================================= -->

            <TextBlock Text="Enjoying LuckyCharm?"
                       FontSize="12"
                       Foreground="#806B55"
                       HorizontalAlignment="Center"/>

            <Button Content="☕  Buy Rohit a Coffee"
                    Width="190"
                    Height="36"
                    Margin="0,5,0,5"
                    HorizontalAlignment="Center"
                    Background="#C9A34A"
                    Foreground="#17243A"
                    FontWeight="SemiBold"
                    FontSize="13"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SupportLuckyCharm_Click"/>

            <TextBlock Text="A small coffee keeps the little charm going ☕"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="#806B55"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>


            <!-- ================================================= -->
            <!-- CLOSE -->
            <!-- ================================================= -->

            <Button Content="Close"
                    Width="100"
                    Height="30"
                    HorizontalAlignment="Center"
                    Background="#FFF9F0"
                    Foreground="#6E6254"
                    BorderBrush="#D8CCB8"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Close_Click"/>

        </StackPanel>

    </Border>

</Window>