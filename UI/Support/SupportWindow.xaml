<Window x:Class="LuckyDangle.UI.Support.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy me a Coffee"
        Width="410"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF9EC">

        <Border Margin="10"
                Background="#FFFDF7"
                BorderBrush="#D9B65C"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">

                <Grid>

                        <!-- ================================================= -->
                        <!-- AMOUNT SCREEN                                     -->
                        <!-- ================================================= -->

                        <Grid x:Name="AmountScreen">

                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>


                                <!-- HEADER -->

                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center">

                                        <TextBlock Text="☕"
                                                   FontSize="26"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Send Rohit a Coffee"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17243A"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,1,0,1"/>

                                        <TextBlock Text="Keep the little charm alive ✨"
                                                   FontSize="12"
                                                   Foreground="#718096"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>

                                </StackPanel>


                                <!-- MESSAGE -->

                                <TextBlock Grid.Row="1"
                                           Text="Choose your amount"
                                           FontSize="12.5"
                                           Foreground="#667085"
                                           HorizontalAlignment="Center"
                                           Margin="0,18,0,9"/>


                                <!-- PRESET AMOUNTS -->

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                        <Button Content="₹100"
                                                Tag="100"
                                                Click="PresetAmount_Click"
                                                Width="72"
                                                Height="34"
                                                Margin="3"
                                                Background="#17243A"
                                                Foreground="White"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                BorderThickness="0"/>

                                        <Button Content="₹150"
                                                Tag="150"
                                                Click="PresetAmount_Click"
                                                Width="72"
                                                Height="34"
                                                Margin="3"
                                                Background="#17243A"
                                                Foreground="White"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                BorderThickness="0"/>

                                        <Button Content="₹200"
                                                Tag="200"
                                                Click="PresetAmount_Click"
                                                Width="72"
                                                Height="34"
                                                Margin="3"
                                                Background="#17243A"
                                                Foreground="White"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                BorderThickness="0"/>

                                </StackPanel>


                                <!-- CUSTOM -->

                                <TextBlock Grid.Row="3"
                                           Text="Or enter another amount  (₹100 – ₹5,000)"
                                           FontSize="11"
                                           Foreground="#7A8494"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,5"/>

                                <TextBox Grid.Row="4"
                                         x:Name="CustomAmountTextBox"
                                         Width="170"
                                         Height="36"
                                         HorizontalAlignment="Center"
                                         Text="100"
                                         Padding="10,3"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#17243A"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         TextChanged="CustomAmountTextBox_TextChanged"
                                         PreviewTextInput="CustomAmountTextBox_PreviewTextInput"
                                         LostFocus="CustomAmountTextBox_LostFocus"
                                         DataObject.Pasting="CustomAmountTextBox_Pasting"/>


                                <!-- PAY + FOOTER -->

                                <StackPanel Grid.Row="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom">

                                        <Button x:Name="PayButton"
                                                Content="Pay ₹100"
                                                Width="145"
                                                Height="36"
                                                Margin="0,0,0,8"
                                                Background="#C9A34A"
                                                Foreground="#17243A"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Click="Pay_Click"/>

                                </StackPanel>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- PAYMENT / QR SCREEN                               -->
                        <!-- ================================================= -->

                        <Grid x:Name="PaymentScreen"
                              Visibility="Collapsed">

                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- HEADER -->

                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center">

                                        <TextBlock Text="Scan to Send Rohit a Coffee"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17243A"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="PaymentAmountText"
                                                   Text="₹100"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#9A7525"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,5"/>

                                </StackPanel>


                                <!-- QR -->

                                <Border Grid.Row="1"
                                        Width="250"
                                        Height="350"
                                        Background="White"
                                        BorderBrush="#D9B65C"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                        <Image x:Name="PaymentQrImage"
                                               Source="/LuckyDangle;component/Assets/Support/lucky_charm_upi_qr.jpg"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               UseLayoutRounding="True"/>

                                </Border>


                                <!-- BOTTOM -->

                                <StackPanel Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,5,0,0">

                                        <TextBlock Text="rohitmallick85@oksbi"
                                                   FontSize="11"
                                                   Foreground="#6F5A32"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                                <Button Content="← Change Amount"
                                                        Width="125"
                                                        Height="29"
                                                        Margin="3"
                                                        Background="Transparent"
                                                        Foreground="#6E6254"
                                                        BorderBrush="#D8CCB8"
                                                        Click="ChangeAmount_Click"/>

                                        </StackPanel>

                                </StackPanel>

                        </Grid>

                </Grid>

        </Border>

</Window>