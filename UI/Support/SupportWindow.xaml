<Window x:Class="LuckyDangle.UI.Support.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy Rohit a Coffee"
        Width="430"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#151822">

    <Border Margin="10"
            Background="#1D202B"
            BorderBrush="#C99A2E"
            BorderThickness="1.2"
            CornerRadius="18"
            Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <TextBlock Text="COFFEE"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#D9B65C"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Buy Rohit a Coffee"
                           FontFamily="Georgia"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FFFDF7"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>

                <TextBlock Text="Support the little charm and help Lucky Dangle grow."
                           FontSize="12"
                           Foreground="#AEB4C3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="MarketText"
                       Text="India payment via Razorpay"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#D9B65C"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,6"/>

            <StackPanel Grid.Row="2"
                        x:Name="PresetPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="Preset1Button"
                        Width="82"
                        Height="36"
                        Margin="4"
                        Tag="100"
                        Click="PresetAmount_Click"
                        Background="#2B2110"
                        Foreground="#FFD866"
                        BorderBrush="#8E6B2D"
                        BorderThickness="1"/>

                <Button x:Name="Preset2Button"
                        Width="82"
                        Height="36"
                        Margin="4"
                        Tag="150"
                        Click="PresetAmount_Click"
                        Background="#2B2110"
                        Foreground="#FFD866"
                        BorderBrush="#8E6B2D"
                        BorderThickness="1"/>

                <Button x:Name="Preset3Button"
                        Width="82"
                        Height="36"
                        Margin="4"
                        Tag="200"
                        Click="PresetAmount_Click"
                        Background="#2B2110"
                        Foreground="#FFD866"
                        BorderBrush="#8E6B2D"
                        BorderThickness="1"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0,10,0,0">

                <TextBlock x:Name="AmountHelpText"
                           Text="Or enter another amount"
                           Foreground="#AEB4C3"
                           FontSize="11.5"
                           HorizontalAlignment="Center"/>

                <TextBox x:Name="CustomAmountTextBox"
                         Width="180"
                         Height="38"
                         HorizontalAlignment="Center"
                         Margin="0,6,0,0"
                         Text="100"
                         Padding="10,5"
                         FontSize="14"
                         FontWeight="SemiBold"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="CustomAmountTextBox_TextChanged"
                         PreviewTextInput="CustomAmountTextBox_PreviewTextInput"
                         LostFocus="CustomAmountTextBox_LostFocus"
                         DataObject.Pasting="CustomAmountTextBox_Pasting"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,10,0,0">

                <TextBlock Text="Email for payment confirmation"
                           Foreground="#D9DCE5"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="EmailTextBox"
                         Height="40"
                         Margin="0,5,0,0"
                         Padding="10,7"
                         FontSize="13"/>
            </StackPanel>

            <TextBlock Grid.Row="5"
                       x:Name="StatusText"
                       Margin="0,10,0,0"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#C7CBD5"
                       FontSize="11.5"/>

            <StackPanel Grid.Row="6"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                <Button x:Name="PayButton"
                        Width="180"
                        Height="38"
                        Content="Pay"
                        Background="#C9A34A"
                        Foreground="#17243A"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="Pay_Click"/>

                <Button Content="Close"
                        Width="110"
                        Height="30"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        Foreground="#AEB4C3"
                        BorderBrush="#3A4050"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>