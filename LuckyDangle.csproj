<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LuckyDangle</AssemblyName>
    <RootNamespace>LuckyDangle</RootNamespace>
    <ApplicationIcon>Assets\LuckyDangle.ico</ApplicationIcon>
    <Version>0.1.7.0</Version>
    <AssemblyVersion>0.1.7.0</AssemblyVersion>
    <FileVersion>0.1.7.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />

    <!-- All dangle artwork -->
    <Content Include="Assets\Dangles\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Resource Include="Assets\LuckyDangle.ico" />
    <Content Include="Assets\LuckyDangle.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- LuckyCharm Share Images -->
    <Resource Include="Assets\Share\lucky_charms_share.png" />
    <Resource Include="Assets\Share\rakhi_share.png" />
    <Resource Include="Assets\Share\spiritual_share.png" />

    <!-- LuckyCharm Support -->
    <Resource Include="Assets\Support\lucky_charm_upi_qr.jpg" />

    <PackageReference Include="QRCoder" Version="1.8.0" />

  </ItemGroup>

</Project>