<Window x:Class="LuckyDangle.PremiumUpsellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lucky Dangle Premium" Width="540" Height="535" MinHeight="300" MaxHeight="620" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Loaded="Window_Loaded">
  <Window.Resources>
    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFF6D365" Offset="0" />
      <GradientStop Color="#FFFFC857" Offset="0.55" />
      <GradientStop Color="#FFFFA928" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#191B24" />
      <Setter Property="Background" Value="{StaticResource GoldBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFD36A" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style x:Key="PlanRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="PlanBorder" Padding="13,10" Background="#1D202B" BorderBrush="#3A4050" BorderThickness="1.5" CornerRadius="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="22" Height="22">
                  <Ellipse Stroke="#777E8D" StrokeThickness="2" Fill="#151822" />
                  <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FFC857" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PlanBorder" Property="BorderBrush" Value="#FFC857" />
                <Setter TargetName="PlanBorder" Property="Background" Value="#252314" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="22" Background="#151822" BorderBrush="#3B3F4D" BorderThickness="1">
    <Grid>
      <Border Height="6" VerticalAlignment="Top" CornerRadius="22,22,0,0" Background="{StaticResource GoldBrush}" />
      <Button Content="X" Width="32" Height="32" Margin="0,14,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#B7BBC8" Background="Transparent" BorderThickness="0" FontSize="15" Cursor="Hand" Click="Close_Click" />
      <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="PurchasePanel">
          <TextBlock Text="Make All Premium Yours" HorizontalAlignment="Center" Foreground="White" FontSize="23" FontWeight="Bold" />
          <TextBlock Text="Unlock all Premium Collections" Margin="0,3,0,15" HorizontalAlignment="Center" Foreground="#AEB4C3" FontSize="13" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="SixMonthPlan" Grid.Column="0" GroupName="Plan" IsChecked="True" Checked="Plan_Checked" Style="{StaticResource PlanRadio}">
              <StackPanel>
                <TextBlock x:Name="SixMonthPriceText" Text="Minimum &#x20B9;199" FontSize="16" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="6 months" Margin="0,2,0,0" FontSize="12" Foreground="#AEB4C3" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="YearPlan" Grid.Column="2" GroupName="Plan" Checked="Plan_Checked" Style="{StaticResource PlanRadio}">
              <StackPanel>
                <TextBlock x:Name="YearPriceText" Text="Minimum &#x20B9;299" FontSize="16" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="1 year" Margin="0,2,0,0" FontSize="12" Foreground="#AEB4C3" />
              </StackPanel>
            </RadioButton>
          </Grid>
          <TextBlock Text="Amount" Margin="2,13,0,4" Foreground="#D9DCE5" FontSize="12.5" FontWeight="SemiBold" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#202430" BorderBrush="#3A4050" BorderThickness="1,1,0,1" CornerRadius="10,0,0,10">
              <TextBlock x:Name="CurrencyText" Text="&#x20B9;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFD36A" FontSize="18" FontWeight="Bold" />
            </Border>
            <TextBox x:Name="AmountTextBox"
                             TextChanged="AmountTextBox_TextChanged" PreviewTextInput="AmountTextBox_PreviewTextInput" Grid.Column="1" Height="42" Padding="10,8" Text="199" FontSize="15" Background="#202430" Foreground="White" BorderBrush="#3A4050" BorderThickness="0,1,1,1" />
          </Grid>
          <TextBlock x:Name="AmountHintText" Text="Minimum &#x20B9;199. You may contribute more if you wish." Margin="2,4,0,0" Foreground="#8F96A6" FontSize="11.5" />
          <TextBlock Text="Email" Margin="2,11,0,4" Foreground="#D9DCE5" FontSize="12.5" FontWeight="SemiBold" />
          <TextBox x:Name="EmailTextBox" Height="42" Padding="10,8" FontSize="14" Background="#202430" Foreground="White" BorderBrush="#3A4050" BorderThickness="1" />
          <TextBlock x:Name="StatusText" Margin="2,7,2,0" TextWrapping="Wrap" Foreground="#AEB4C3" FontSize="11.5" />
          <Button x:Name="UnlockButton" Content="Unlock Premium" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}" Click="Unlock_Click" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="Already purchased?" Foreground="#8F96A6" VerticalAlignment="Center" FontSize="12" />
            <Button Content="Have a license?" Margin="3,0,0,0" Style="{StaticResource LinkButton}" Click="Restore_Click" />
          </StackPanel>          <TextBlock Text="Refund Policy: Premium payments are generally non-refundable. Please verify your plan, email and amount before paying."
                     Margin="8,8,8,0"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Foreground="#C9A85A"
                     FontSize="10.5"
                     FontWeight="SemiBold" />
        </StackPanel>
        <!-- Clean post-payment state -->
        <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Background="#2A351E" BorderBrush="#7B9636" BorderThickness="1">
            <TextBlock Text="&#x2713;" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="#B8E068" />
          </Border>
          <TextBlock Text="Premium Activated" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold" />
          <TextBlock x:Name="SuccessExpiryText" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#D5D8E4" FontSize="14" />
          <TextBlock Text="All Premium dangles are now available on this PC." Margin="0,5,0,18" HorizontalAlignment="Center" Foreground="#969DAD" FontSize="12.5" />
          <Button Content="Save &amp; Close" Style="{StaticResource PrimaryButton}" Click="SaveClose_Click" x:Name="SuccessCloseButton" />
        </StackPanel>
        <!-- Restore is intentionally separate and small -->
        <StackPanel x:Name="RestorePanel" Visibility="Collapsed" VerticalAlignment="Center">
          <TextBlock Text="Restore Premium" HorizontalAlignment="Center" Foreground="White" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Use the email connected to your purchase." Margin="0,4,0,15" HorizontalAlignment="Center" Foreground="#AEB4C3" FontSize="12.5" />
          <TextBlock Text="Email" Foreground="#D9DCE5" FontSize="12.5" FontWeight="SemiBold" />
          <TextBox x:Name="RestoreEmailTextBox" Height="42" Margin="0,4,0,0" Padding="10,8" FontSize="14" Background="#202430" Foreground="White" BorderBrush="#3A4050" BorderThickness="1" />
          <Button x:Name="SendRestoreCodeButton" Content="Send Verification Code" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="SendRestoreCode_Click" />
          <TextBlock Text="6-digit verification code" Margin="0,12,0,0" Foreground="#D9DCE5" FontSize="12.5" FontWeight="SemiBold" />
          <TextBox x:Name="RestoreCodeTextBox" Height="42" Margin="0,4,0,0" Padding="10,8" FontSize="16" MaxLength="6" Background="#202430" Foreground="White" BorderBrush="#3A4050" BorderThickness="1" />
          <TextBlock x:Name="RestoreInfoText" Margin="0,8,0,0" Text="" TextWrapping="Wrap" Foreground="#8F96A6" FontSize="11.5" />
          <Button x:Name="VerifyRestoreButton" Content="Verify &amp; Restore" Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="VerifyRestore_Click" />
          <Button Content="Back to Purchase" Margin="0,10,0,0" Style="{StaticResource LinkButton}" Click="BackToPurchase_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>