<Window x:Class="LuckyDangle.CharmPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- SHADOW                                            -->
        <!-- ================================================= -->

        <DropShadowEffect x:Key="PremiumShadow"
                          Color="#18243A"
                          BlurRadius="30"
                          ShadowDepth="8"
                          Opacity="0.28"/>


        <!-- ================================================= -->
        <!-- FILTER PILL                                       -->
        <!-- ================================================= -->

        <ControlTemplate x:Key="FilterPillTemplate"
                         TargetType="Button">

            <Border x:Name="PillBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="24"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#304563"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#3B4F6D"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>


        <!-- ================================================= -->
        <!-- GOLD ACTION BUTTON                                -->
        <!-- ================================================= -->

        <Style x:Key="PremiumUseButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#C99A2E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E6C15C"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- CANCEL BUTTON                                     -->
        <!-- ================================================= -->

        <Style x:Key="PremiumCancelButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFDF8"/>

            <Setter Property="Foreground"
                    Value="#17243A"/>

            <Setter Property="BorderBrush"
                    Value="#9BA9BB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    
        <Style x:Key="FooterActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#203047"/>
            <Setter Property="Background" Value="#FFFDF8"/>
            <Setter Property="BorderBrush" Value="#C7A24D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>


    <!-- ===================================================== -->
    <!-- OUTER PREMIUM SHELL                                  -->
    <!-- ===================================================== -->

    <Border Background="#FBF7ED"
            CornerRadius="28"
            BorderBrush="#C8A04A"
            BorderThickness="1.5"
            Padding="18,14,18,16"
            Effect="{StaticResource PremiumShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Height="42"
                  Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="0">

                    <!-- TITLE + SUBTITLE Î“Ã‡Ã¶ SAME LINE -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Choose your dangle"
                                   FontFamily="Georgia"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#13233B"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Find the little companion you want on your desktop."
                                   FontSize="14"
                                   Foreground="#708097"
                                   VerticalAlignment="Center"
                                   Margin="16,7,0,0"/>

                    </StackPanel>

                    <!-- GOLD ACCENT -->
                    <Border Width="62"
                            Height="3"
                            Background="#C79A31"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"/>

                </StackPanel>


                <!-- CLOSE -->

                <Button x:Name="GetNewDanglesButton"
                        Grid.Column="1"
                        Width="160"
                        Height="34"
                        Padding="10,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#17243A"
                        Background="#E3C46C"
                        BorderBrush="#C79A31"
                        BorderThickness="1"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,6,0"
                        Click="GetNewDanglesButton_Click">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x2726;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Get New Dangles"
                                   FontFamily="Segoe UI"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
        Content="&#x00D7;"
        Width="38"
        Height="38"
        FontSize="27"
        FontWeight="Light"
        Foreground="#53647A"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        Click="CloseButton_Click"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="0,-2,0,0"/>

            </Grid>


            <!-- ================================================= -->
            <!-- FILTER BAR                                        -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#12243D"
                    CornerRadius="27"
                    Padding="6"
                    Margin="0,0,0,8">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">

                    <StackPanel x:Name="FilterPanel"
                                Orientation="Horizontal"/>

                </ScrollViewer>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#182A42"
                    CornerRadius="19"
                    BorderBrush="#344963"
                    BorderThickness="1"
                    Padding="5">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Header collapses completely in Collections view -->
                        <RowDefinition Height="Auto"/>

                        <!-- Cards -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- COLLECTION HEADER                                 -->
                    <!-- ================================================= -->

                    <Grid x:Name="CollectionHeader"
                          Grid.Row="0"
                          Height="46"
                          Margin="0,0,0,4">

                        <Grid.ColumnDefinitions>

                            <!-- Back button -->
                            <ColumnDefinition Width="180"/>

                            <!-- Collection title -->
                            <ColumnDefinition Width="*"/>

                            <!-- Design count -->
                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- BACK TO COLLECTIONS                               -->
                        <!-- ================================================= -->

                        <StackPanel x:Name="BackPanel"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Panel.ZIndex="20"/>


                        <!-- ================================================= -->
                        <!-- COLLECTION TITLE                                  -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Icon + title -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="CollectionIcon"
                                           Text="â‰¡Æ’Ã®â••"
                                           FontSize="27"
                                           VerticalAlignment="Center"
                                           Margin="0,0,9,0"/>

                                <TextBlock x:Name="CollectionTitle"
                                           Text="Rakhi Collection"
                                           FontFamily="Georgia"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Foreground="#FFFDF7"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- Subtitle -->

                            <TextBlock x:Name="CollectionSubtitle"
                                       Text="Love  Î“Ã‡Ã³  Protection  Î“Ã‡Ã³  Bond Forever"
                                       FontSize="12.5"
                                       Foreground="#E3C46C"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- DESIGN COUNT                                      -->
                        <!-- ================================================= -->

                        <Border Grid.Column="2"
                                Background="#1D304B"
                                BorderBrush="#C99B35"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="15,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">

                            <TextBlock x:Name="CollectionCount"
                                       Text="6 designs"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E6C56B"/>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- DANGLER / COLLECTION CARDS                         -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Top"
                                  Background="Transparent">

                        <WrapPanel x:Name="DanglePanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,8"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
                  Margin="0,13,0,0"
                  Height="54">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- COLLECTION COUNT -->

                <TextBlock x:Name="CountText"
                           Grid.Column="0"
                           Text="6 dangles"
                           FontSize="12.5"
                           Foreground="#64748A"
                           VerticalAlignment="Center"/>

                <!-- DISPLAY MODE -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">

                    <TextBlock Text="Mode"
                               FontFamily="Georgia"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#17243A"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Border Width="214"
                            Height="32"
                            Background="#FFFDF8"
                            BorderBrush="#C9B16D"
                            BorderThickness="1"
                            CornerRadius="16"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="109"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DesktopOnlyButton"
                                    Grid.Column="0"
                                    Content="Desktop Only"
                                    Height="30"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="#17243A"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="DesktopOnlyButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="15,0,0,15"
                                                Padding="8,0">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="#D9C78F"
                                    Margin="0,5"/>

                            <Button x:Name="AlwaysOnTopButton"
                                    Grid.Column="2"
                                    Content="Always on Top"
                                    Height="30"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="#53647A"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AlwaysOnTopButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="0,15,15,0"
                                                Padding="8,0">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>
                    </Border>

                </StackPanel>
                <!-- ACTIONS -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- PREMIUM -->

                    <Button x:Name="PremiumAccessButton"
                            Width="116"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PremiumAccessButton_Click" MinWidth="116">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#261E0F"
                                        BorderBrush="#D6A62B"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="11,5">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="PREMIUM"
                                                   Foreground="#F2C84B"
                                                   FontWeight="Bold"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#D6A62B"
                                                CornerRadius="8"
                                                Margin="7,0,0,0"
                                                Padding="6,2">
                                            <TextBlock x:Name="PremiumBadgeText"
                                                       Text="{TemplateBinding Tag}"
                                                       Foreground="#172033"
                                                       FontWeight="Bold"
                                                       FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- COFFEE -->

                    <Button x:Name="BuyCoffeeButton" Width="104"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BuyCoffeeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFF9EA"
                                        BorderBrush="#D3AC46"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="11,5">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#x2615;"
                                                   FontSize="12.5"
                                                   Foreground="#7A5510"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="☕ Coffee"
                                                   Foreground="#7A5510"
                                                   FontFamily="Georgia"
                                                   FontStyle="Italic"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- CANCEL -->

                    <Button Content="Cancel"
                            Width="82"
                            Height="36"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFDF8"
                                        BorderBrush="#B9C3CF"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="10,5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextElement.Foreground="#42546A"
                                        TextElement.FontSize="12"
                                        TextElement.FontWeight="SemiBold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Save &amp; Use -->

                    <Button Content="Save &amp; Use"
                            Width="118"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ApplyButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#D4A62A"
                                        BorderBrush="#E7C85D"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="12,5">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#x2713;"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Save &amp; Use"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>
