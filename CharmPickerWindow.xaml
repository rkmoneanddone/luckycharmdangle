<Window x:Class="LuckyDangle.CharmPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- SHADOW                                            -->
        <!-- ================================================= -->

        <DropShadowEffect x:Key="PremiumShadow"
                          Color="#18243A"
                          BlurRadius="30"
                          ShadowDepth="8"
                          Opacity="0.28"/>


        <!-- ================================================= -->
        <!-- FILTER PILL                                       -->
        <!-- ================================================= -->

        <ControlTemplate x:Key="FilterPillTemplate"
                         TargetType="Button">

            <Border x:Name="PillBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="24"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#304563"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#3B4F6D"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>


        <!-- ================================================= -->
        <!-- GOLD ACTION BUTTON                                -->
        <!-- ================================================= -->

        <Style x:Key="PremiumUseButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#C99A2E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E6C15C"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- CANCEL BUTTON                                     -->
        <!-- ================================================= -->

        <Style x:Key="PremiumCancelButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFDF8"/>

            <Setter Property="Foreground"
                    Value="#17243A"/>

            <Setter Property="BorderBrush"
                    Value="#9BA9BB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    
        <Style x:Key="FooterActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#203047"/>
            <Setter Property="Background" Value="#FFFDF8"/>
            <Setter Property="BorderBrush" Value="#C7A24D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>


    <!-- ===================================================== -->
    <!-- OUTER PREMIUM SHELL                                  -->
    <!-- ===================================================== -->

    <Border Background="#FBF7ED"
            CornerRadius="28"
            BorderBrush="#C8A04A"
            BorderThickness="1.5"
            Padding="18,14,18,16"
            Effect="{StaticResource PremiumShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Height="42"
                  Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="0">

                    <!-- TITLE + SUBTITLE Î“Ã‡Ã¶ SAME LINE -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Choose your dangle"
                                   FontFamily="Georgia"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#13233B"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Find the little companion you want on your desktop."
                                   FontSize="14"
                                   Foreground="#708097"
                                   VerticalAlignment="Center"
                                   Margin="16,7,0,0"/>

                    </StackPanel>

                    <!-- GOLD ACCENT -->
                    <Border Width="62"
                            Height="3"
                            Background="#C79A31"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"/>

                </StackPanel>


                <!-- CLOSE -->

                <Button x:Name="GetNewDanglesButton"
                        Grid.Column="1"
                        Width="160"
                        Height="34"
                        Padding="10,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#17243A"
                        Background="#E3C46C"
                        BorderBrush="#C79A31"
                        BorderThickness="1"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,6,0"
                        Click="GetNewDanglesButton_Click">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x2726;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Get New Dangles"
                                   FontFamily="Segoe UI"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
        Content="&#x00D7;"
        Width="38"
        Height="38"
        FontSize="27"
        FontWeight="Light"
        Foreground="#53647A"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        Click="CloseButton_Click"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="0,-2,0,0"/>

            </Grid>


            <!-- ================================================= -->
            <!-- FILTER BAR                                        -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#12243D"
                    CornerRadius="27"
                    Padding="6"
                    Margin="0,0,0,8">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">

                    <StackPanel x:Name="FilterPanel"
                                Orientation="Horizontal"/>

                </ScrollViewer>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#182A42"
                    CornerRadius="19"
                    BorderBrush="#344963"
                    BorderThickness="1"
                    Padding="5">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Header collapses completely in Collections view -->
                        <RowDefinition Height="Auto"/>

                        <!-- Cards -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- COLLECTION HEADER                                 -->
                    <!-- ================================================= -->

                    <Grid x:Name="CollectionHeader"
                          Grid.Row="0"
                          Height="46"
                          Margin="0,0,0,4">

                        <Grid.ColumnDefinitions>

                            <!-- Back button -->
                            <ColumnDefinition Width="180"/>

                            <!-- Collection title -->
                            <ColumnDefinition Width="*"/>

                            <!-- Design count -->
                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- BACK TO COLLECTIONS                               -->
                        <!-- ================================================= -->

                        <StackPanel x:Name="BackPanel"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Panel.ZIndex="20"/>


                        <!-- ================================================= -->
                        <!-- COLLECTION TITLE                                  -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Icon + title -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="CollectionIcon"
                                           Text="â‰¡Æ’Ã®â••"
                                           FontSize="27"
                                           VerticalAlignment="Center"
                                           Margin="4,0,8,0"/>

                                <TextBlock x:Name="CollectionTitle"
                                           Text="Rakhi Collection"
                                           FontFamily="Georgia"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Foreground="#FFFDF7"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- Subtitle -->

                            <TextBlock x:Name="CollectionSubtitle"
                                       Text="Love  Î“Ã‡Ã³  Protection  Î“Ã‡Ã³  Bond Forever"
                                       FontSize="12.5"
                                       Foreground="#E3C46C"
                                       HorizontalAlignment="Center"
                                       Margin="4,0,8,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- DESIGN COUNT                                      -->
                        <!-- ================================================= -->

                        <Border Grid.Column="2"
                                Background="#1D304B"
                                BorderBrush="#C99B35"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="15,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">

                            <TextBlock x:Name="CollectionCount"
                                       Text="6 designs"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E6C56B"/>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- DANGLER / COLLECTION CARDS                         -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Top"
                                  Background="Transparent">

                        <WrapPanel x:Name="DanglePanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,8"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
      Margin="0,10,0,0"
      MinHeight="68"
      VerticalAlignment="Center">

    <Grid.ColumnDefinitions>
        <!-- Collection count -->
        <ColumnDefinition Width="Auto"/>

        <!-- Gap -->
        <ColumnDefinition Width="14"/>

        <!-- Smaller Display Mode -->
        <ColumnDefinition Width="190"/>

        <!-- Gap -->
        <ColumnDefinition Width="14"/>

        <!-- Remaining action area -->
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- COLLECTION COUNT -->

    <TextBlock x:Name="CountText"
               Grid.Column="0"
               Text="6 dangles"
               FontSize="13"
               FontWeight="Medium"
               Foreground="#64748A"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>

    <!-- DISPLAY MODE -->

    <Grid Grid.Column="2"
          Width="190"
          VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Display Mode"
                   FontFamily="Georgia"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#17243A"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="NoWrap"/>

        <Border Grid.Row="2"
                Width="190"
                Height="34"
                Background="#FFFDF8"
                BorderBrush="#D3A42E"
                BorderThickness="1.2"
                CornerRadius="17"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94.5"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="94.5"/>
                </Grid.ColumnDefinitions>

                <!-- DESKTOP ONLY -->

                <Button x:Name="DesktopOnlyButton"
                        Grid.Column="0"
                        Content="Desktop Only"
                        Height="32"
                        Padding="3,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#17243A"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="DesktopOnlyButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="16,0,0,16"
                                    Padding="{TemplateBinding Padding}">

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- DIVIDER -->

                <Border Grid.Column="1"
                        Width="1"
                        Background="#D9C78F"
                        Margin="0,5"/>

                <!-- ALWAYS ON TOP -->

                <Button x:Name="AlwaysOnTopButton"
                        Grid.Column="2"
                        Content="Always on Top"
                        Height="32"
                        Padding="3,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#53647A"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AlwaysOnTopButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="0,16,16,0"
                                    Padding="{TemplateBinding Padding}">

                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>

    <!-- ACTION AREA -->

    <Grid Grid.Column="4"
          VerticalAlignment="Center">

        <Grid.ColumnDefinitions>
            <!-- Premium button starts from left -->
            <ColumnDefinition Width="Auto"/>

            <ColumnDefinition Width="10"/>

            <!-- Coffee button -->
            <ColumnDefinition Width="Auto"/>

            <!-- Flexible space -->
            <ColumnDefinition Width="*"/>

            <!-- Cancel -->
            <ColumnDefinition Width="Auto"/>

            <ColumnDefinition Width="8"/>

            <!-- Save SaveSave -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- PREMIUM -->

        <Button x:Name="PremiumAccessButton"
                Grid.Column="0"
                Width="168"
                Height="42"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="PremiumAccessButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="#E4B936"
                            BorderThickness="1.3"
                            CornerRadius="21"
                            Padding="8,2">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#17130B"
                                              Offset="0"/>
                                <GradientStop Color="#352708"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="PREMIUM"
                                       Foreground="#FFD75A"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Border Background="#D6A62B"
                                    CornerRadius="10"
                                    Margin="8,0,0,0"
                                    Padding="5,3">

                                <TextBlock x:Name="PremiumBadgeText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#172033"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- BUY ROHIT A COFFEE -->

        <Button x:Name="BuyCoffeeButton"
                Grid.Column="2"
                Width="180"
                Height="42"
                Padding="2"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BuyCoffeeButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="#D3A42E"
                            BorderThickness="1.3"
                            CornerRadius="21"
                            Padding="10,2">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="#FFFDF6"
                                              Offset="0"/>
                                <GradientStop Color="#FFF1C5"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="&#x2615;"
                                       FontSize="16"
                                       Foreground="#815A0C"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Buy Rohit a Coffee"
                                       Foreground="#714B08"
                                       FontFamily="Georgia"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       FontSize="13.5"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- CANCEL -->

        <Button Grid.Column="4"
                Content="Cancel"
                Width="78"
                Height="42"
                Padding="8,3"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#FFFDF8"
                            BorderBrush="#B9C3CF"
                            BorderThickness="1.2"
                            CornerRadius="21"
                            Padding="8,4">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="#42546A"
                            TextElement.FontSize="16"
                            TextElement.FontWeight="SemiBold"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- SAVE AND USE -->

        <Button Grid.Column="6"
                Content="Save &amp; Use"
                Width="130"
                Height="42"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="ApplyButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="#F0CF63"
                            BorderThickness="1.3"
                            CornerRadius="21"
                            Padding="8,4">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#E7BD3A"
                                              Offset="0"/>
                                <GradientStop Color="#C89410"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="&#x2713;"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Save &amp; Use"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Grid>

        </Grid>

    </Border>

</Window>
