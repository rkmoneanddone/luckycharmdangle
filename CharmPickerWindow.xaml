<Window x:Class="LuckyDangle.CharmPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- SHADOW                                            -->
        <!-- ================================================= -->

        <DropShadowEffect x:Key="PremiumShadow"
                          Color="#18243A"
                          BlurRadius="30"
                          ShadowDepth="8"
                          Opacity="0.28"/>


        <!-- ================================================= -->
        <!-- FILTER PILL                                       -->
        <!-- ================================================= -->

        <ControlTemplate x:Key="FilterPillTemplate"
                         TargetType="Button">

            <Border x:Name="PillBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="24"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#304563"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="PillBorder"
                            Property="Background"
                            Value="#3B4F6D"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>


        <!-- ================================================= -->
        <!-- GOLD ACTION BUTTON                                -->
        <!-- ================================================= -->

        <Style x:Key="PremiumUseButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#C99A2E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E6C15C"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- CANCEL BUTTON                                     -->
        <!-- ================================================= -->

        <Style x:Key="PremiumCancelButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFDF8"/>

            <Setter Property="Foreground"
                    Value="#17243A"/>

            <Setter Property="BorderBrush"
                    Value="#9BA9BB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- OUTER PREMIUM SHELL                                  -->
    <!-- ===================================================== -->

    <Border Background="#FBF7ED"
            CornerRadius="28"
            BorderBrush="#C8A04A"
            BorderThickness="1.5"
            Padding="18,14,18,16"
            Effect="{StaticResource PremiumShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Height="62"
                  Margin="0,0,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="0">

                    <TextBlock Text="Choose your dangle"
                               FontFamily="Georgia"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#13233B"/>

                    <TextBlock Text="Find the little companion you want on your desktop."
                               FontSize="14"
                               Foreground="#708097"
                               Margin="0,4,0,0"/>

                    <Border Width="62"
                            Height="3"
                            Background="#C79A31"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"/>

                </StackPanel>


                <!-- CLOSE -->

                <Button Grid.Column="1"
                        Content="×"
                        Width="36"
                        Height="36"
                        FontSize="24"
                        Foreground="#53647A"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"/>

            </Grid>


            <!-- ================================================= -->
            <!-- FILTER BAR                                        -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#12243D"
                    CornerRadius="27"
                    Padding="6"
                    Margin="0,0,0,8">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">

                    <StackPanel x:Name="FilterPanel"
                                Orientation="Horizontal"/>

                </ScrollViewer>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- MAIN GALLERY                                      -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#182A42"
                    CornerRadius="19"
                    BorderBrush="#344963"
                    BorderThickness="1"
                    Padding="5">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Header collapses completely in Collections view -->
                        <RowDefinition Height="Auto"/>

                        <!-- Cards -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- COLLECTION HEADER                                 -->
                    <!-- ================================================= -->

                    <Grid x:Name="CollectionHeader"
                          Grid.Row="0"
                          Height="62"
                          Margin="0,0,0,4">

                        <Grid.ColumnDefinitions>

                            <!-- Back button -->
                            <ColumnDefinition Width="180"/>

                            <!-- Collection title -->
                            <ColumnDefinition Width="*"/>

                            <!-- Design count -->
                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- BACK TO COLLECTIONS                               -->
                        <!-- ================================================= -->

                        <StackPanel x:Name="BackPanel"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Panel.ZIndex="20"/>


                        <!-- ================================================= -->
                        <!-- COLLECTION TITLE                                  -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Icon + title -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="CollectionIcon"
                                           Text="🌸"
                                           FontSize="27"
                                           VerticalAlignment="Center"
                                           Margin="0,0,9,0"/>

                                <TextBlock x:Name="CollectionTitle"
                                           Text="Rakhi Collection"
                                           FontFamily="Georgia"
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Foreground="#FFFDF7"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- Subtitle -->

                            <TextBlock x:Name="CollectionSubtitle"
                                       Text="Love  •  Protection  •  Bond Forever"
                                       FontSize="12.5"
                                       Foreground="#E3C46C"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- DESIGN COUNT                                      -->
                        <!-- ================================================= -->

                        <Border Grid.Column="2"
                                Background="#1D304B"
                                BorderBrush="#C99B35"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="15,7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">

                            <TextBlock x:Name="CollectionCount"
                                       Text="6 designs"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E6C56B"/>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- DANGLER / COLLECTION CARDS                         -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Top"
                                  Background="Transparent">

                        <WrapPanel x:Name="DanglePanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,8"/>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
                  Margin="0,15,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- COUNT -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="CountText"
                               Text="6 dangles"
                               FontSize="12.5"
                               Foreground="#64748A"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <!-- BUTTONS -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="Cancel"
                            Width="105"
                            Height="42"
                            Margin="0,0,9,0"
                            Padding="18,0"
                            Style="{StaticResource PremiumCancelButton}"
                            Click="CloseButton_Click"/>

                    <Button Content="✦  Use Dangle"
                            Width="145"
                            Height="42"
                            Padding="18,0"
                            Style="{StaticResource PremiumUseButton}"
                            Click="ApplyButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</Window>