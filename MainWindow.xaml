<Window x:Class="LuckyDangle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Width="320"
        Height="320"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Canvas x:Name="Root">

        <!-- ================================================= -->
        <!-- SMALL MOVE HANDLE                                -->
        <!-- Only this small area moves the WHOLE dangle      -->
        <!-- ================================================= -->

        <Rectangle x:Name="MoveHandle"
                   Canvas.Left="135"
                   Canvas.Top="0"
                   Width="50"
                   Height="35"
                   Fill="Transparent"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="MoveHandle_MouseLeftButtonDown"
                   MouseMove="MoveHandle_MouseMove"
                   MouseLeftButtonUp="MoveHandle_MouseLeftButtonUp"/>


        <!-- ================================================= -->
        <!-- FIXED ANCHOR                                      -->
        <!-- ================================================= -->

        <Ellipse Canvas.Left="157"
                 Canvas.Top="5"
                 Width="6"
                 Height="6"
                 Fill="#8A6A35"
                 IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- STRING                                            -->
        <!-- ================================================= -->

        <Line x:Name="DangleString"
              X1="160"
              Y1="8"
              X2="160"
              Y2="82"
              Stroke="#B88B45"
              StrokeThickness="2"
              IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- BEAD                                              -->
        <!-- ================================================= -->

        <Ellipse x:Name="DangleBead"
                 Canvas.Left="152"
                 Canvas.Top="74"
                 Width="16"
                 Height="16"
                 Fill="#D6A93A"
                 Stroke="#7A571B"
                 StrokeThickness="1"
                 IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- CHARM                                             -->
        <!-- Only this is pulled with spring physics          -->
        <!-- ================================================= -->

        <Canvas x:Name="CharmCanvas"
                Canvas.Left="115"
                Canvas.Top="82"
                Width="90"
                Height="115"
                Cursor="Hand"
                MouseLeftButtonDown="Charm_MouseLeftButtonDown"
                MouseMove="Charm_MouseMove"
                MouseLeftButtonUp="Charm_MouseLeftButtonUp"
                MouseRightButtonUp="Charm_MouseRightButtonUp">

            <Ellipse Width="90"
                     Height="90"
                     Fill="#D72638"
                     Stroke="#7A101B"
                     StrokeThickness="2"/>

            <Ellipse Canvas.Left="12"
                     Canvas.Top="12"
                     Width="66"
                     Height="66"
                     Fill="#F6D365"
                     Stroke="#9C6D00"
                     StrokeThickness="2"/>

            <TextBlock Text="福"
                       FontSize="43"
                       FontWeight="Bold"
                       Foreground="#8A101A"
                       Width="90"
                       Height="90"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="0,5,0,0"/>

            <!-- Tassel -->

            <Rectangle Canvas.Left="43"
                       Canvas.Top="88"
                       Width="4"
                       Height="22"
                       Fill="#B51F2D"/>

            <Ellipse Canvas.Left="37"
                     Canvas.Top="106"
                     Width="16"
                     Height="10"
                     Fill="#B51F2D"/>

        </Canvas>


        <!-- ================================================= -->
        <!-- CONTEXT MENU                                      -->
        <!-- ================================================= -->

        <!-- ================================================= -->
<!-- ULTRA COMPACT PREMIUM CONTEXT MENU              -->
<!-- ================================================= -->

<Canvas.ContextMenu>

    <ContextMenu x:Name="Menu"
                 Width="195"
                 Background="#FFFDF7"
                 BorderBrush="#D8C79D"
                 BorderThickness="1"
                 Padding="2">

        <ContextMenu.Resources>

            <!-- ========================================= -->
            <!-- NORMAL ITEM                              -->
            <!-- ========================================= -->

            <Style TargetType="{x:Type MenuItem}">

                <Setter Property="Height"
                        Value="24"/>

                <Setter Property="FontSize"
                        Value="12"/>

                <Setter Property="FontWeight"
                        Value="SemiBold"/>

                <Setter Property="FontFamily"
                        Value="Segoe UI"/>

                <Setter Property="Foreground"
                        Value="#29364A"/>

                <Setter Property="Background"
                        Value="Transparent"/>

                <Setter Property="Padding"
                        Value="0"/>

                <Setter Property="Margin"
                        Value="1,1"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="{x:Type MenuItem}">

                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="0">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <!-- SMALL ICON AREA -->

                                        <ColumnDefinition Width="27"/>

                                        <!-- TEXT -->

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- ICON -->

                                    <ContentPresenter
                                        Grid.Column="0"
                                        ContentSource="Icon"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"/>


                                    <!-- TEXT -->

                                    <ContentPresenter
                                        Grid.Column="1"
                                        ContentSource="Header"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"/>

                                </Grid>

                            </Border>


                            <ControlTemplate.Triggers>

                                <Trigger Property="IsHighlighted"
                                         Value="True">

                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="#F4E8C9"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>


            <!-- ========================================= -->
            <!-- SUPPORT ITEM                              -->
            <!-- ========================================= -->

            <Style x:Key="SupportMenuItem"
                   TargetType="{x:Type MenuItem}">

                <Setter Property="Height"
                        Value="26"/>

                <Setter Property="FontSize"
                        Value="12"/>

                <Setter Property="FontFamily"
                        Value="Georgia"/>

                <Setter Property="FontStyle"
                        Value="Italic"/>

                <Setter Property="FontWeight"
                        Value="Bold"/>

                <Setter Property="Foreground"
                        Value="#765316"/>

                <Setter Property="Background"
                        Value="#FFF0C7"/>

                <Setter Property="Margin"
                        Value="1,2"/>

                <Setter Property="Padding"
                        Value="0"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="{x:Type MenuItem}">

                            <Border x:Name="SupportBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="0">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="27"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <ContentPresenter
                                        Grid.Column="0"
                                        ContentSource="Icon"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"/>


                                    <ContentPresenter
                                        Grid.Column="1"
                                        ContentSource="Header"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"/>

                                </Grid>

                            </Border>


                            <ControlTemplate.Triggers>

                                <Trigger Property="IsHighlighted"
                                         Value="True">

                                    <Setter TargetName="SupportBorder"
                                            Property="Background"
                                            Value="#E5CD8E"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>


            <!-- ========================================= -->
            <!-- SEPARATOR                                 -->
            <!-- ========================================= -->

            <Style TargetType="{x:Type Separator}">

                <Setter Property="Height"
                        Value="1"/>

                <Setter Property="Margin"
                        Value="7,2"/>

                <Setter Property="Background"
                        Value="#E2D8C4"/>

            </Style>

        </ContextMenu.Resources>


        <!-- CHANGE -->

        <MenuItem Header="Change Dangle"
                  Click="ChangeDangle_Click">

            <MenuItem.Icon>

                <TextBlock Text="✦"
                           FontSize="17"
                           Foreground="#7146B8"/>

            </MenuItem.Icon>

        </MenuItem>


        <!-- RANDOM -->

        <MenuItem Header="Random Dangle"
                  Click="RandomDangle_Click">

            <MenuItem.Icon>

                <TextBlock Text="⚄"
                           FontSize="17"
                           Foreground="#2875A8"/>

            </MenuItem.Icon>

        </MenuItem>


        <Separator/>


        <!-- SWING -->

        <MenuItem Header="Swing"
                  Click="Swing_Click">

            <MenuItem.Icon>

                <TextBlock Text="〰"
                           FontSize="19"
                           Foreground="#D18A00"/>

            </MenuItem.Icon>

        </MenuItem>


        <Separator/>


        <!-- ABOUT -->

        <MenuItem Header="About LuckyCharm"
                  Click="AboutLuckyDangle_Click">

            <MenuItem.Icon>

                <TextBlock Text="ⓘ"
                           FontSize="17"
                           Foreground="#3977C9"/>

            </MenuItem.Icon>

        </MenuItem>


        <!-- SUPPORT -->

        <MenuItem Header="Send Rohit a Coffee"
                  Style="{StaticResource SupportMenuItem}"
                  Click="SupportLuckyCharm_Click">

            <MenuItem.Icon>

                <TextBlock Text="☕"
                           FontSize="18"
                           Foreground="#9A6A16"/>

            </MenuItem.Icon>

        </MenuItem>


        <Separator/>


        <!-- SHARE -->

        <!-- SHARE -->

        <MenuItem Header="Share This"
                Click="ShareDangle_Click">

            <MenuItem.Icon>

                <TextBlock Text="↗"
                        FontSize="17"
                        Foreground="#2E8B57"/>

            </MenuItem.Icon>

        </MenuItem>

        <Separator/>

        <!-- EXIT -->

        <MenuItem Header="Exit"
                  Click="Exit_Click">

            <MenuItem.Icon>

                <TextBlock Text="⏻"
                           FontSize="17"
                           Foreground="#C94B4B"/>

            </MenuItem.Icon>

        </MenuItem>

    </ContextMenu>

</Canvas.ContextMenu>

    </Canvas>

</Window>