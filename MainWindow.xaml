<Window x:Class="LuckyDangle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        Width="320"
        Height="320"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Canvas x:Name="Root">

        <!-- ================================================= -->
        <!-- SMALL MOVE HANDLE                                -->
        <!-- Only this small area moves the WHOLE dangle      -->
        <!-- ================================================= -->

        <Rectangle x:Name="MoveHandle"
                   Canvas.Left="135"
                   Canvas.Top="0"
                   Width="50"
                   Height="35"
                   Fill="Transparent"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="MoveHandle_MouseLeftButtonDown"
                   MouseMove="MoveHandle_MouseMove"
                   MouseLeftButtonUp="MoveHandle_MouseLeftButtonUp"/>


        <!-- ================================================= -->
        <!-- FIXED ANCHOR                                      -->
        <!-- ================================================= -->

        <Ellipse Canvas.Left="157"
                 Canvas.Top="5"
                 Width="6"
                 Height="6"
                 Fill="#8A6A35"
                 IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- STRING                                            -->
        <!-- ================================================= -->

        <Line x:Name="DangleString"
              X1="160"
              Y1="8"
              X2="160"
              Y2="82"
              Stroke="#B88B45"
              StrokeThickness="2"
              IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- BEAD                                              -->
        <!-- ================================================= -->

        <Ellipse x:Name="DangleBead"
                 Canvas.Left="152"
                 Canvas.Top="74"
                 Width="16"
                 Height="16"
                 Fill="#D6A93A"
                 Stroke="#7A571B"
                 StrokeThickness="1"
                 IsHitTestVisible="False"/>


        <!-- ================================================= -->
        <!-- CHARM                                             -->
        <!-- Only this is pulled with spring physics          -->
        <!-- ================================================= -->

        <Canvas x:Name="CharmCanvas"
                Canvas.Left="115"
                Canvas.Top="82"
                Width="90"
                Height="115"
                Cursor="Hand"
                MouseLeftButtonDown="Charm_MouseLeftButtonDown"
                MouseMove="Charm_MouseMove"
                MouseLeftButtonUp="Charm_MouseLeftButtonUp"
                MouseRightButtonUp="Charm_MouseRightButtonUp">

            <Ellipse Width="90"
                     Height="90"
                     Fill="#D72638"
                     Stroke="#7A101B"
                     StrokeThickness="2"/>

            <Ellipse Canvas.Left="12"
                     Canvas.Top="12"
                     Width="66"
                     Height="66"
                     Fill="#F6D365"
                     Stroke="#9C6D00"
                     StrokeThickness="2"/>

            <TextBlock Text="福"
                       FontSize="43"
                       FontWeight="Bold"
                       Foreground="#8A101A"
                       Width="90"
                       Height="90"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="0,5,0,0"/>

            <!-- Tassel -->

            <Rectangle Canvas.Left="43"
                       Canvas.Top="88"
                       Width="4"
                       Height="22"
                       Fill="#B51F2D"/>

            <Ellipse Canvas.Left="37"
                     Canvas.Top="106"
                     Width="16"
                     Height="10"
                     Fill="#B51F2D"/>

        </Canvas>


        <!-- ================================================= -->
        <!-- CONTEXT MENU                                      -->
        <!-- ================================================= -->

        <!-- ================================================= -->
<!-- ULTRA COMPACT PREMIUM CONTEXT MENU              -->
<!-- ================================================= -->

<Canvas.ContextMenu>
    <ContextMenu x:Name="Menu"
                 Width="230"
                 Background="#FFFCF4"
                 BorderBrush="#D3A93B"
                 BorderThickness="1"
                 Padding="6"
                 FontFamily="Segoe UI"
                 FontSize="13">

        <ContextMenu.Effect>
            <DropShadowEffect Color="#16253C"
                              BlurRadius="18"
                              ShadowDepth="5"
                              Opacity="0.26"/>
        </ContextMenu.Effect>

        <ContextMenu.Resources>

            <!-- ================================================= -->
            <!-- PREMIUM MENU ITEM                                 -->
            <!-- ================================================= -->

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#172A44"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="1,1"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            Background="#FFF4D4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <ContentPresenter ContentSource="Icon"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,8,0"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="#F6E7B7"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================= -->
            <!-- GOLD SUPPORT ITEM                                 -->
            <!-- ================================================= -->

            <Style x:Key="SupportMenuItem"
                   TargetType="{x:Type MenuItem}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Georgia"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#6F4C0B"/>
                <Setter Property="Background" Value="#FFF0BD"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="1,3"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="SupportBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#E2C16B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            Background="#FFF8E7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <ContentPresenter ContentSource="Icon"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,8,0"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="SupportBorder"
                                            Property="Background"
                                            Value="#F1D98F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================= -->
            <!-- UPDATE ITEM                                       -->
            <!-- ================================================= -->

            <Style x:Key="UpdateMenuItem"
                   TargetType="{x:Type MenuItem}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#7A5400"/>
                <Setter Property="Background" Value="#FFF5D7"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="1,3"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="UpdateBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#D7B24B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            Background="#E1B946"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <ContentPresenter ContentSource="Icon"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,8,0"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="UpdateBorder"
                                            Property="Background"
                                            Value="#F2DF9B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================= -->
            <!-- SEPARATOR                                         -->
            <!-- ================================================= -->

            <Style TargetType="{x:Type Separator}">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="10,4"/>
                <Setter Property="Background" Value="#E7DCC4"/>
            </Style>

        </ContextMenu.Resources>


        <MenuItem Header="Change Dangle"
                  Click="ChangeDangle_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x2726;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           Foreground="#7650B8"/>
            </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="Random Dangle"
                  Click="RandomDangle_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x21BB;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="16"
                           Foreground="#2D75A8"/>
            </MenuItem.Icon>
        </MenuItem>

        <Separator/>

        <MenuItem Header="Swing"
                  Click="Swing_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x223F;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="18"
                           Foreground="#C88700"/>
            </MenuItem.Icon>
        </MenuItem>

        <Separator/>

        <MenuItem Header="About Lucky Dangle"
                  Click="AboutLuckyDangle_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x24D8;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           Foreground="#3977C9"/>
            </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="Send Rohit a Coffee"
                  Style="{StaticResource SupportMenuItem}"
                  Click="SupportLuckyCharm_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x2615;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           Foreground="#8F6415"/>
            </MenuItem.Icon>
        </MenuItem>

        <Separator/>

        <MenuItem x:Name="UpdateLuckyDangleMenuItem"
                  Header="Update Lucky Dangle"
                  Style="{StaticResource UpdateMenuItem}"
                  Visibility="Collapsed"
                  Click="UpdateLuckyDangle_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x21E7;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#17304A"/>
            </MenuItem.Icon>
        </MenuItem>

        <Separator x:Name="UpdateLuckyDangleSeparator"
                   Visibility="Collapsed"/>

        <MenuItem Header="Share This Dangle"
                  Click="ShareDangle_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x2197;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="16"
                           Foreground="#2E8B57"/>
            </MenuItem.Icon>
        </MenuItem>

        <Separator/>

        <MenuItem Header="Exit Lucky Dangle"
                  Click="Exit_Click">
            <MenuItem.Icon>
                <TextBlock Text="&#x23FB;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="15"
                           Foreground="#C94B4B"/>
            </MenuItem.Icon>
        </MenuItem>

    </ContextMenu>
</Canvas.ContextMenu>

    </Canvas>

</Window>